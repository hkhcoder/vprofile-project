# 4. Security Group for the EC2 Instance
resource "aws_security_group" "this" {
  name        = "web-sg"
  description = "Allow HTTP and SSH traffic"    
  vpc_id      = var.vpc_id

  ingress {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  } 

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}